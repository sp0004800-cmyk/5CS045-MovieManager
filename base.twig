<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>{% block title %}Movie Manager{% endblock %}</title><link rel="stylesheet" href="style.css"></head><body><header><h1>Movie Manager</h1><nav>{% if logged_in %}<a href="list-movies.php">All movies</a> <a href="add_movie.php">Add movie</a> <a href="search_movie.php">Search</a><form action="logout.php" method="post"><input type="hidden" name="csrf" value="{{ csrf }}"><button>Logout</button></form>{% else %}<a href="login.php">Login</a> <a href="register.php">Register</a>{% endif %}</nav></header><main>{% if error %}<p class="error" role="alert">{{ error }}</p>{% endif %}{% block content %}{% endblock %}</main></body></html>
