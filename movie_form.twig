{% extends 'base.twig' %}{% block content %}<h2>{{ heading }}</h2><form method="post"><input type="hidden" name="csrf" value="{{ csrf }}"><label>Movie name <input name="movie_name" maxlength="100" required value="{{ movie.movie_name }}"></label><label>Genre <input name="genre" maxlength="200" required value="{{ movie.genre }}"></label><label>Price <input type="number" name="price" min="0" max="99999.99" step="0.01" required value="{{ movie.price }}"></label><label>Release date <input type="date" name="date_released" required value="{{ movie.date_released }}"></label><button>Save movie</button> <a href="list-movies.php">Cancel</a></form>{% endblock %}
