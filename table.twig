<p>{{ movies|length }} movie(s) found.</p><div class="table-wrap"><table><thead><tr><th>ID</th><th>Movie name</th><th>Genre</th><th>Price (£)</th><th>Release date</th><th>Actions</th></tr></thead><tbody>{% for movie in movies %}<tr><td>{{ movie.movie_id }}</td><td>{{ movie.movie_name }}</td><td>{{ movie.genre }}</td><td>{{ movie.price|number_format(2) }}</td><td>{{ movie.date_released }}</td><td><a href="edit_movie.php?id={{ movie.movie_id }}">Edit</a> <a href="delete_movie.php?id={{ movie.movie_id }}">Delete</a></td></tr>{% else %}<tr><td colspan="6">No movies found.</td></tr>{% endfor %}</tbody></table></div>
