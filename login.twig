{% extends 'base.twig' %}{% block content %}<h2>Login</h2><form method="post"><input type="hidden" name="csrf" value="{{ csrf }}"><label>Username <input name="username" required maxlength="100" autocomplete="username"></label><label>Password <input type="password" name="password" required autocomplete="current-password"></label><label>CAPTCHA: {{ question }} = <input name="captcha" required inputmode="numeric"></label><button>Login</button></form>{% endblock %}
