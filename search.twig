{% extends 'base.twig' %}{% block content %}<h2>Search movies</h2><form id="search" method="get"><label>Movie name <input name="name" maxlength="100" value="{{ filters.name }}"></label><label>Genre <input name="genre" maxlength="200" value="{{ filters.genre }}"></label><label>Release year <input name="year" type="number" min="1000" max="9999" value="{{ filters.year }}"></label><label>Maximum price <input name="price" type="number" min="0" max="99999.99" step="0.01" value="{{ filters.price }}"></label><button>Search</button></form><section id="results" aria-live="polite">{% include 'table.twig' %}</section><script src="search.js" defer></script>{% endblock %}
